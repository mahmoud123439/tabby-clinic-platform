# Do not put production secrets in this file or commit them.
# Provide a fresh 32-byte base64 key through a protected environment/secret manager.
CLINIC_DATA_KEY=
# Optional local settings; the server binds only to loopback by default.
HOST=127.0.0.1
PORT=3000
# For an HTTPS reverse proxy in a reviewed production deployment:
# COOKIE_SECURE=1
# TRUST_HTTPS_PROXY=1
# CLINIC_DB_PATH=/secure/persistent/volume/clinic.sqlite
